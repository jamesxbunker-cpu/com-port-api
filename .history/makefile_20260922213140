CC     = gcc
CFLAGS = -Wall -Wextra -O2 -Iinc
LIBS   = -lkernel32

all: readcom.exe comstreamd.exe client.exe

readcom.exe: src/main.c src/serial.c
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

comstreamd.exe: src/daemon.c
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

client.exe: src/client.c
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

clean:
	rm -f *.exe *.o

.PHONY: all clean